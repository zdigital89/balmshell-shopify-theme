<section class="section cart-page" aria-labelledby="cart-title">
  <div class="section-heading collection-heading-simple">
    <p class="eyebrow">your balm bag</p>
    <h1 id="cart-title">Cart</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <form class="cart-form" action="{{ routes.cart_url }}" method="post">
      <div class="cart-items">
        {%- for item in cart.items -%}
          <article class="cart-item">
            <a class="cart-item-image" href="{{ item.url }}">
              {%- if item.image -%}
                {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt | escape }}
              {%- endif -%}
            </a>
            <div class="cart-item-copy">
              <h2>{{ item.product.title }}</h2>
              {%- unless item.product.has_only_default_variant -%}<p>{{ item.variant.title }}</p>{%- endunless -%}
              <p>{{ item.final_line_price | money_without_trailing_zeros }}</p>
              <label>
                <span>Quantity</span>
                <input class="order-qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </label>
              <a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="cart-summary">
        <p class="eyebrow">order total</p>
        <strong>{{ cart.total_price | money_without_trailing_zeros }}</strong>
        <p>Taxes and shipping are calculated at checkout.</p>
        <button class="button button-secondary" type="submit">Update cart</button>
        <button class="button button-primary" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {%- else -%}
    <div class="empty-cart">
      <p>Your balm bag is empty.</p>
      <a class="button button-primary" href="{{ routes.all_products_collection_url }}">Shop products</a>
    </div>
  {%- endif -%}
</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
