<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} - {{ shop.name }}{% endunless %}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Inter:wght@500;700;800&display=swap" rel="stylesheet">
  {{ 'balmshell.css' | asset_url | stylesheet_tag }}
</head>
<body>
  {% section 'balmshell-header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'balmshell-footer' %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var modal = document.querySelector('.newsletter-modal.is-open');
      if (!modal) return;

      document.body.appendChild(modal);
      document.body.classList.add('newsletter-modal-active');

      var close = modal.querySelector('.newsletter-modal-close');
      if (close) {
        close.addEventListener('click', function (event) {
          event.preventDefault();
          modal.classList.remove('is-open');
          document.body.classList.remove('newsletter-modal-active');
        });
      }
    });
  </script>
</body>
</html>
